{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "konzert-haus",
  "main": "src/index.tsx",
  "compatibility_date": "2025-04-01",
  // Workers Cache: serve repeat GETs from the edge without invoking the Worker.
  // Every route already sets an explicit Cache-Control; anything that must not
  // be cached (/healthz, /api/push/me) says `no-store` at the handler, because
  // a response with no Cache-Control falls back to a 2h heuristic TTL instead
  // of staying uncached. Deploys invalidate the cache, which is what we want:
  // the scrape workflow pushes fresh data and CF redeploys on push.
  "cache": {
    "enabled": true
  },
  // Apex → frankfurt.konzert.haus 301 is handled in src/index.tsx. The city
  // is parsed from the subdomain (`<city>.konzert.haus` falls back to
  // "frankfurt"), so each new city needs an additional CF custom_domain.
  "routes": [
    { "pattern": "frankfurt.konzert.haus", "custom_domain": true },
    { "pattern": "hamburg.konzert.haus", "custom_domain": true },
    { "pattern": "darmstadt.konzert.haus", "custom_domain": true },
    { "pattern": "heidelberg.konzert.haus", "custom_domain": true },
    { "pattern": "mainz.konzert.haus", "custom_domain": true },
    { "pattern": "wiesbaden.konzert.haus", "custom_domain": true },
    { "pattern": "konzert.haus", "custom_domain": true }
  ],
  // Scraping happens in .github/workflows/scrape.yml — the GH Action
  // regenerates src/scrape-data.ts and pushes; CF redeploys on push.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "konzert-haus-db",
      "database_id": "6c36c9b8-d1a2-4d9c-9db4-83d31be9ffca"
    }
  ],
  "triggers": {
    "crons": ["0 5,6 * * *", "0 15,16 * * *", "0 7,8 * * SUN"]
  },
  "send_email": [
    {
      "name": "FEEDBACK_EMAIL",
      "destination_address": "feedback@konzert.haus"
    }
  ],
  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAADNxRIr9duIRP8ag"
  },
  "assets": {
    "directory": "./public",
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    }
  }
}
